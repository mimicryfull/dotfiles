{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4,
    },
  },
  "display": {
    "separator": "    ",
    "color": {
      "keys": "blue",
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "blue",
        "host": "cyan",
      },
    },
    {
      "type": "custom",
      "format": "──────────────────────────────",
    },
    {
      "type": "os",
      "key": " ",
      "format": "Arch Linux",
    },
    {
      "type": "kernel",
      "key": " ",
    },
    {
      "type": "uptime",
      "key": "󰅐 ",
    },
    {
      "type": "packages",
      "key": "󰏗 ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "wm",
      "key": " ",
    },
    {
      "type": "terminalfont",
      "key": " ",
    },
    {
      "type": "memory",
      "key": "󰍛 ",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
    "break",
  ],
}
