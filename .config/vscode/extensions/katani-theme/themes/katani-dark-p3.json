    "button.hoverBackground": "#7cc0fa",
    
    "dropdown.background": "#131822",
    "dropdown.border": "#384154",
    "dropdown.foreground": "#abb2bf",
    
    "input.background": "#131822",
    "input.border": "#384154",
    "input.foreground": "#abb2bf",
    "input.placeholderForeground": "#75819a",
    
    "scrollbarSlider.background": "#30384980",
