    "terminal.background": "#0B0E14",
    "terminal.foreground": "#abb2bf",
    "terminal.ansiBlack": "#3f4451",
    "terminal.ansiRed": "#e8777f",
    "terminal.ansiGreen": "#97ca72",
    "terminal.ansiYellow": "#ebc275",
    "terminal.ansiBlue": "#5ab0f6",
    "terminal.ansiMagenta": "#ca72e4",
    "terminal.ansiCyan": "#4dbdcb",
    "terminal.ansiWhite": "#d7dae0",
    "terminal.ansiBrightBlack": "#69758d",
    "terminal.ansiBrightRed": "#f08a91",
    "terminal.ansiBrightGreen": "#abdc86",
    "terminal.ansiBrightYellow": "#f2ce8c",
    "terminal.ansiBrightBlue": "#7cc0fa",
    "terminal.ansiBrightMagenta": "#dd8cf2",
    "terminal.ansiBrightCyan": "#6ccfdb",
    "terminal.ansiBrightWhite": "#eceff4"
