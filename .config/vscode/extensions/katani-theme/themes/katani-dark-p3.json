    "panelTitle.inactiveForeground": "#8a92a3",
    
    "statusBar.background": "#080B10",
    "statusBar.foreground": "#abb2bf",
    "statusBar.border": "#2d3546",
    "statusBar.noFolderBackground": "#080B10",
    "statusBar.debuggingBackground": "#ca72e4",
    
    "titleBar.activeBackground": "#080B10",
    "titleBar.activeForeground": "#abb2bf",
