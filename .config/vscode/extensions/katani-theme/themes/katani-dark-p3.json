    "sideBar.border": "#2d3546",
    "sideBarSectionHeader.background": "#080B10",
    
    "editorGroup.border": "#2d3546",
    "editorGroupHeader.tabsBackground": "#080B10",
    
    "tab.activeBackground": "#0F1219",
