{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Katani Dark",
  "author": "Based on Modest Dark by Timothy Cole",
  "themes": [
    {
      "name": "Katani Dark",
      "appearance": "dark",
      "style": {
        "border": "#1e242e",
        "border.variant": "#1e242e",
        "border.focused": "#3e4452",
        "border.selected": "#3e4452",
        "border.transparent": "#00000000",
        "border.disabled": "#2c313a",

        "elevated_surface.background": "#0F1219",
        "surface.background": "#0F1219",
        "background": "#0F1219",

        "element.background": "#1e242e",
        "element.hover": "#171c26",
        "element.active": "#262c38",
        "element.selected": "#2c313a",
        "element.disabled": "#171c26",
        "drop_target.background": "#5ab0f620",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#1e242e",
