        "ignored": "#636b78",
        "ignored.background": "#0F1219",
        "ignored.border": "#2c313a",
        "info": "#5ab0f6",
        "info.background": "#0F1219",
        "info.border": "#3e7aac",
        "modified": "#e5c07b",
        "modified.background": "#3a3220",
        "modified.border": "#5a4b2a",
        "predictive": "#5C6B89",
        "predictive.background": "#0F1219",
        "predictive.border": "#2c313a",
        "renamed": "#5ab0f6",
        "renamed.background": "#1b2f45",
        "renamed.border": "#3e7aac",
        "success": "#a5e075",
        "success.background": "#3b5135",
        "success.border": "#4b6a43",
        "unreachable": "#636b78",
        "unreachable.background": "#0F1219",
        "unreachable.border": "#2c313a",
        "warning": "#ebc275",
        "warning.background": "#0F1219",
        "warning.border": "#a68752",

