          "function": { "color": "#5ab0f6", "font_style": "italic" },
          "function.method": { "color": "#5ab0f6", "font_style": "italic" },
          "hint": { "color": "#4f5b73" },
          "keyword": { "color": "#ca72e4", "font_style": "italic" },
          "label": { "color": "#e06c75" },
          "lifetime": { "color": "#d99a5e", "font_style": "italic" },
          "link_text": { "color": "#5ab0f6" },
          "link_uri": { "color": "#56b6c2" },
          "number": { "color": "#d99a5e" },
          "operator": { "color": "#6F8A99" },
          "predictive": { "color": "#5C6B89", "font_style": "italic" },
          "preproc": { "color": "#ca72e4" },
          "primary": { "color": "#abb2bf" },
          "primitive": { "color": "#ebc275" },
          "property": { "color": "#e06c75" },
          "punctuation": { "color": "#A6B3CC" },
          "punctuation.bracket": { "color": "#A6B3CC" },
          "punctuation.delimiter": { "color": "#6F8A99" },
          "punctuation.list_marker": { "color": "#e06c75" },
          "punctuation.special": { "color": "#6F8A99" },
          "string": { "color": "#97ca72" },
          "string.escape": { "color": "#97ca72" },
          "string.regex": { "color": "#97ca72" },
          "string.special": { "color": "#56b6c2" },
          "string.special.symbol": { "color": "#56b6c2" },
          "tag": { "color": "#e06c75" },
          "text.literal": { "color": "#97ca72" },
          "title": { "color": "#e06c75", "font_weight": 700 },
          "type": { "color": "#ebc275" },
          "variable": { "color": "#f07178" },
          "variable.member": { "color": "#e06c75" },
          "variable.parameter": { "color": "#e06c75" },
          "variable.special": { "color": "#ff8fa3", "font_style": "italic" },
          "variant": { "color": "#e06c75" }
