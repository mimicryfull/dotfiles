          {
            "cursor": "#c162de",
            "background": "#c162de",
            "selection": "#c162de33"
          },
          {
            "cursor": "#8cc265",
            "background": "#8cc265",
            "selection": "#8cc26533"
          },
          {
            "cursor": "#ebc275",
            "background": "#ebc275",
            "selection": "#ebc27533"
          },
          {
            "cursor": "#ef5f6b",
            "background": "#ef5f6b",
            "selection": "#ef5f6b33"
          },
          {
            "cursor": "#4dbdcb",
            "background": "#4dbdcb",
            "selection": "#4dbdcb33"
          },
          {
            "cursor": "#d99a5e",
            "background": "#d99a5e",
            "selection": "#d99a5e33"
          },
          {
            "cursor": "#de73ff",
            "background": "#de73ff",
            "selection": "#de73ff33"
          }
        ],

