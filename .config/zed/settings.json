{
  "cursor_shape": "block",
  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",
  "restore_on_startup": "last_session",
  "buffer_font_family": "MonoLisaCode",
  "buffer_font_features": {
    "calt": true,
    "cv01": true,
    "cv02": true,
    "cv03": true,
    "cv04": true,
    "cv05": true,
    "cv06": true,
    "cv07": true,
    "cv08": true,
    "cv09": true,
    "cv10": true,
    "cv11": true,
    "dlig": true,
    "liga": true,
    "ss04": true,
    "ss11": true,
    "ss13": true,
    "zero": true
  },
  "buffer_font_size": 18.0,
  "buffer_font_weight": 450,
  "buffer_line_height": "standard",
  "code_actions_on_format": {
    "source.organizeImports": true
  },
  "disable_ai": true,
  "format_on_save": "on",
  "cursor_blink": false,
  "current_line_highlight": "all",
  "sticky_scroll": {
    "enabled": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "indent_guides": {
    "coloring": "fixed",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": true
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "buildScripts": {
            "enable": true
          },
          "features": "all",
          "targetDir": true
        },
        "check": {
          "command": "clippy",
          "allTargets": true,
          "extraArgs": ["--", "-W", "clippy::pedantic", "-W", "clippy::nursery"]
        },
        "completion": {
          "limit": 1000
        },
        "imports": {
          "granularity": {
            "group": "module"
          }
        },
        "inlayHints": {
          "maxLength": 25,
          "parameterHints": {
            "enable": true
          },
          "typeHints": {
            "enable": true
          },
          "chainingHints": {
            "enable": true
          },
          "closureReturnTypeHints": {
            "enable": "always"
          },
          "lifetimeElisionHints": {
            "enable": "always"
          },
          "closingBraceHints": {
            "enable": true,
            "minLines": 25
          }
        },
        "procMacro": {
          "enable": true
        }
      }
    }
  },
  "project_panel": {
    "dock": "left",
    "file_icons": true,
    "auto_fold_dirs": true
  },
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "show_whitespaces": "selection",
  "snippet_sort_order": "bottom",
  "telemetry": {
    "metrics": false
  },
  "terminal": {
    "blinking": "off",
    "cursor_shape": "block",
    "font_family": "Maple Mono NF",
    "font_size": 17.0
  },
  "theme": "Katani Dark P3",
  "ui_font_family": "MonoLisaText",
  "ui_font_features": {
    "calt": true,
    "liga": true,
    "zero": true
  },
  "ui_font_size": 16.0,
  "ui_font_weight": 450,

  "git_commit_buffer_font_size": 16
}
